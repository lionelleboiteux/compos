{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "compos-l1-cache",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",
  "observability": { "enabled": true },
  // The page itself is rendered by the Worker (src/render.js); public/ holds
  // only its static files (og-image, ads.txt, the two shirt badges). Only
  // the dynamic paths run the Worker; static files are served directly and
  // don't count against the Worker request quota.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/journee/*", "/__*"]
  },
  "rules": [{ "type": "Text", "globs": ["**/*.css"], "fallthrough": true }],
  // The page is served from this custom domain; workers.dev stays enabled
  // for the JSON routes (debugging / older consumers).
  "routes": [{ "pattern": "l1.compos.fantasy-coach.fr", "custom_domain": true }],
  "workers_dev": true,
  "kv_namespaces": [
    { "binding": "CACHE", "id": "2e8bedbee42c4b93a813533f0de24a7a" }
  ],
  "vars": {
    // Not a secret -- this exact URL is already public, embedded in
    // frontend/index.html today. Kept as a var (not a secret) so it's
    // visible/diffable in version control like everything else here.
    "APPS_SCRIPT_BASE": "https://script.google.com/macros/s/AKfycby7k1DeAKMJFeSLMCHtQntyU0hGseKmN4ZMxuMMDjugFTh-H4wTNvk5TA32CM5By7aMng/exec"
  }
}
